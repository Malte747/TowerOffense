  - m_Id: 9682796470275
    m_Localized: Dieser Zauberer beherrscht die Kunst der dunklen Magie.
    m_Metadata:
      m_Items: []
  - m_Id: 9682800664576
    m_Localized: Verbannter Hexer
    m_Metadata:
      m_Items: []
  - m_Id: 9682800664577
    m_Localized: T
    m_Metadata:
      m_Items: []
  - m_Id: 9682800664578
    m_Localized: "Eiener der auserkohrenen des K\xF6nigs."
    m_Metadata:
      m_Items: []
  - m_Id: 9682800664579
    m_Localized: Ritter der Tafel
    m_Metadata:
      m_Items: []
  - m_Id: 9682800664580
    m_Localized: R
    m_Metadata:
      m_Items: []
  - m_Id: 9682800664581
    m_Localized: Eine Riesiges Biest, welches Tower fokussiert.
