  - m_Id: 9682838413312
    m_Localized: Er wollte eigentlich nie der Armee beitreten.
    m_Metadata:
      m_Items: []
  - m_Id: 9682838413313
    m_Localized: Einfacher Krieger
    m_Metadata:
      m_Items: []
  - m_Id: 9682838413314
    m_Localized: R
    m_Metadata:
      m_Items: []
  - m_Id: 9682838413315
    m_Localized: "Trolle lieben frischen Fisch und K\xE4se. Fokussiert Tower."
