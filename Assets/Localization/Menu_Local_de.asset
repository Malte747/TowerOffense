    m_Localized: Verteidiger
    m_Metadata:
      m_Items: []
  - m_Id: 9682683224064
    m_Localized: 'SO WIRD GESPIELT

'
    m_Metadata:
      m_Items: []
  - m_Id: 9682683224065
    m_Localized: Dein aktuelles Versorgungslimit
    m_Metadata:
      m_Items: []
  - m_Id: 9682683224066
    m_Localized: "Dein aktuelles Einkommen, welches du am Anfang jeder Runde erh\xE4lst\n"
    m_Metadata:
      m_Items: []
  - m_Id: 9682683224067
    m_Localized: Dein aktuelles Gold
    m_Metadata:
      m_Items: []
  - m_Id: 9682687418368
    m_Localized: 'Tooltipp:'
    m_Metadata:
      m_Items: []
  - m_Id: 9682687418369
    m_Localized: "\nWenn du beim plazieren die \"SHIFT\" Taste gedr\xFCckt h\xE4lst,
      kannst du mehrere Dinge hintereinander plazieren."
    m_Metadata:
      m_Items: []
  - m_Id: 9682687418370
    m_Localized: 'Tooltipp:'
    m_Metadata:
      m_Items: []
  - m_Id: 9682687418371
    m_Localized: "\nBenutze die angezeigten Tastenk\xFCrzel auf deiner Tastatur um
      schneller Truppen oder Tower auszuw\xE4hlen."
    m_Metadata:
      m_Items: []
  - m_Id: 9682687418372
    m_Localized: "Zeigt dir die \naktulle sowie die maximale Rundenzahl."
    m_Metadata:
      m_Items: []
  - m_Id: 9682687418373
    m_Localized: "Mit diesen Reglern \nkannst du die Geschwindigkeit des Spiels steuern."
    m_Metadata:
      m_Items: []
  - m_Id: 9682687418374
    m_Localized: 'Allgemein

'
    m_Metadata:
      m_Items: []
  - m_Id: 9682687418375
    m_Localized: Angreifer
    m_Metadata:
      m_Items: []
  - m_Id: 9682687418376
    m_Localized: Verteidiger
    m_Metadata:
      m_Items: []
  - m_Id: 9682687418377
    m_Localized: 'SO WIRD GESPIELT

'
    m_Metadata:
      m_Items: []
  - m_Id: 9682687418378
    m_Localized: Gewinnen
    m_Metadata:
      m_Items: []
  - m_Id: 9682687418379
    m_Localized: Upgrades
    m_Metadata:
      m_Items: []
  - m_Id: 9682687418380
    m_Localized: Truppen
    m_Metadata:
      m_Items: []
  - m_Id: 9682695806976
    m_Localized: "Zerst\xF6re die feindliche Burgmauer um das Spiel zu gewinnen."
    m_Metadata:
      m_Items: []
  - m_Id: 9682695806977
    m_Localized: "Kaufe Upgrades um deine Angriffe zu verst\xE4rken."
    m_Metadata:
      m_Items: []
  - m_Id: 9682695806978
    m_Localized: "Upgrades k\xF6nnen dir Spielentscheidende Vorteile bringen, aber
      auch viel Gold kosten. Nutze sie weise."
    m_Metadata:
      m_Items: []
  - m_Id: 9682695806979
    m_Localized: "Erschaffe Truppen mit Gold um gegnerische Tower zu zerst\xF6ren.\n\nJede
      plazierte Einheit erh\xF6ht dein Gold Einkommen f\xFCr die n\xE4chsten Runden."
    m_Metadata:
      m_Items: []
  - m_Id: 9682695806980
    m_Localized: 'Allgemein

'
    m_Metadata:
      m_Items: []
  - m_Id: 9682695806981
    m_Localized: Angreifer
    m_Metadata:
      m_Items: []
  - m_Id: 9682695806982
    m_Localized: Verteidiger
    m_Metadata:
      m_Items: []
  - m_Id: 9682695806983
    m_Localized: 'SO WIRD GESPIELT

'
    m_Metadata:
      m_Items: []
  - m_Id: 9682700001280
    m_Localized: Tier Upgrades
    m_Metadata:
      m_Items: []
  - m_Id: 9682700001281
    m_Localized: Minen
    m_Metadata:
      m_Items: []
  - m_Id: 9682700001282
    m_Localized: Tower
    m_Metadata:
      m_Items: []
  - m_Id: 9682700001283
    m_Localized: "Er\xF6he deine Tier Stufe um neue, noch m\xE4chtigere Tower, freizuschalten."
    m_Metadata:
      m_Items: []
  - m_Id: 9682700001284
    m_Localized: "Minen erh\xF6hen jede Runde, in der sie leben, dauerhaft dein Einkommen
      f\xFCr die folgenden Runden."
    m_Metadata:
      m_Items: []
  - m_Id: 9682700001285
    m_Localized: "Repariere besch\xE4digte Tower, oder rei\xDFe Tower ab die im Weg
      stehen."
    m_Metadata:
      m_Items: []
  - m_Id: 9682700001286
    m_Localized: "Baue Tower f\xFCr Gold um deine Burg zu verteidigen. Jeder Tower
      hat einzigartige Attribute und Effekte.\n\nWenn du deine Burgmauer bis zur
      letzen Runde verteidigt hast, gewinnst du."
    m_Metadata:
      m_Items: []
  - m_Id: 9682700001287
    m_Localized: 'Allgemein

'
    m_Metadata:
      m_Items: []
  - m_Id: 9682704195584
    m_Localized: Angreifer
    m_Metadata:
      m_Items: []
  - m_Id: 9682704195585
    m_Localized: Verteidiger
